{
  "name": "@car-platform/eslint-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "*.mjs"
  ],
  "exports": {
    "./base": "./base.mjs",
    "./node": "./node.mjs",
    "./react": "./react.mjs",
    "./react-native": "./react-native.mjs"
  },
  "scripts": {
    "build": "node --check base.mjs && node --check node.mjs && node --check react.mjs && node --check react-native.mjs",
    "lint": "eslint .",
    "test": "node --test",
    "typecheck": "node --check base.mjs && node --check node.mjs && node --check react.mjs && node --check react-native.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "eslint": "^10.10.0"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  }
}
